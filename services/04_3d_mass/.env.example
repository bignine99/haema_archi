# ====================================================
# HAEMA ARCHI - 환경 변수 템플릿
# ====================================================
# 이 파일은 Git에 커밋해도 안전합니다 (값이 없음)
# 사용법: 이 파일을 복사하여 .env 파일을 생성하세요
#   copy .env.example .env
# ====================================================

# === 카카오 REST API ===
# 발급처: https://developers.kakao.com/console/app/1394191
# 용도: 주소 검색, 역지오코딩, 카테고리/키워드 검색
KAKAO_REST_KEY=

# === VWorld API ===
# 발급처: https://www.vworld.kr/dev/v4dv_2dguide_s001.do
# 용도: 위성지도 타일, 지적도 폴리곤, 건물 데이터(LT_C_SPBD)
# 주의: 등록 도메인이 http://localhost 인지 확인
VWORLD_API_KEY=

# === 건축물대장 API (공공데이터포털) ===
# 발급처: https://www.data.go.kr/
# API: 건축물대장정보 서비스 (국토교통부)
# 주의: 디코딩 키를 입력 (코드에서 encodeURIComponent 적용)
BUILDING_REGISTER_API_KEY=

# === Gemini AI API ===
# 발급처: https://aistudio.google.com/app/apikey
# 용도: AI 법규분석, 대지분석, 과업지시서 분석
GEMINI_API_KEY=

# === 토지이용규제정보 API (공공데이터포털) ===
# 발급처: https://www.data.go.kr/
# API: 국토교통부_토지이용규제정보서비스
LAND_USE_API_KEY=
