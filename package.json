{
    "name": "haema-archi-workspace",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "npm run dev:all",
        "dev:frontend": "cd frontend && npm run dev",
        "dev:landuse": "npx kill-port 8010 && cd services/land_use_regulation && python land_use_service.py serve",
        "dev:all": "concurrently --names \"FRONTEND,LANDUSE\" --prefix-colors \"cyan,yellow\" \"npm run dev:frontend\" \"npm run dev:landuse\"",
        "install:all": "cd frontend && npm install --legacy-peer-deps"
    },
    "devDependencies": {
        "concurrently": "^8.2.0"
    },
    "dependencies": {
        "pdf-parse": "^2.4.5",
        "pdfjs-dist": "^3.11.174"
    }
}
